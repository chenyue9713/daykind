# DayKind environment variables. Copy to .env.local and adjust.
# Never commit real secrets; .env.local is git-ignored.

# Where the app reads data from. Only "sample" exists today: invented,
# clearly labeled, read-only records for reviewing the interface.
DAYKIND_DATA_SOURCE=sample

# IANA timezone used to decide what "today" is for the sample data.
DAYKIND_SAMPLE_TIMEZONE=America/Los_Angeles

# --- Not used yet: placeholders for the next stages ---
# Managed authentication and PostgreSQL (e.g. Supabase) will add values such as:
# DATABASE_URL=
# AUTH_SECRET=
# Transactional email for reminders (later task):
# EMAIL_PROVIDER_API_KEY=
